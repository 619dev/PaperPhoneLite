PORT=3000
JWT_SECRET=replace_with_a_long_random_value
DB_HOST=mysql
DB_PORT=3306
DB_USER=paperphonelite
DB_PASS=replace_with_a_database_password
DB_NAME=paperphonelite
MYSQL_ROOT_PASSWORD=replace_with_a_root_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=replace_with_a_redis_password
